# Copy this file to .env and fill in your real values.
#
# NOTE: on a fresh MySQL/MariaDB install, the root account is often
# configured for socket auth only (works fine for `mysql -u root` in a
# terminal, but the Node driver connects over TCP and will get
# "Access denied for user 'root'@'localhost'"). Create a dedicated
# app user instead - see the "Database user for the API" section in
# the main README.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=payroll_app
DB_PASSWORD=change_me
DB_NAME=employee_payroll_system
PORT=3000
